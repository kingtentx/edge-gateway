<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 10pt</ApplicationDefaultFont>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
    <AssemblyName>EdgeGateway.WinForms</AssemblyName>
    <RootNamespace>EdgeGateway.WinForms</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 分部类资源按文件名命名，避免从 MainForm 类型推断出与主窗体相同的资源名。 -->
    <EmbeddedResource Update="MainForm.Monitoring.resx">
      <ManifestResourceName>$(RootNamespace).MainForm.Monitoring</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EdgeGateway.Model/EdgeGateway.Model.csproj" />
    <ProjectReference Include="../EdgeGateway.Abstractions/EdgeGateway.Abstractions.csproj" />
    <ProjectReference Include="../EdgeGateway.DataAccess/EdgeGateway.DataAccess.csproj" />
    <ProjectReference Include="../EdgeGateway.Service/EdgeGateway.Service.csproj" />
    <ProjectReference Include="../EdgeGateway.OpcUa/EdgeGateway.OpcUa.csproj" />
    <ProjectReference Include="../EdgeGateway.IotGateway/EdgeGateway.IotGateway.csproj" />
    <ProjectReference Include="../../Plugins/Drivers/EdgeGateway.Driver.Simulator/EdgeGateway.Driver.Simulator.csproj" />
    <ProjectReference Include="../../Plugins/Drivers/EdgeGateway.Driver.Modbus/EdgeGateway.Driver.Modbus.csproj" />
  </ItemGroup>
</Project>
